generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Event {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  startsAt       DateTime?
  endsAt         DateTime?
  adminTokenHash String
  createdAt      DateTime       @default(now())

  locations      Location[]
  agendaSlots    AgendaSlot[]
  state          EventState?
  announcements  Announcement[]
  chatRooms      ChatRoom[]
  chatMessages   ChatMessage[]

  travelStops    TravelStop[]
  travelSteps    TravelStep[]
  travelPlaces   TravelPlace[]
  notePages      NotePage[]

  @@index([slug])
}

model Location {
  id      String  @id @default(cuid())
  eventId String
  title   String
  lat     Float?
  lng     Float?
  address String?
  note    String?

  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agendaSlots  AgendaSlot[]

  @@index([eventId])
}

model AgendaSlot {
  id         String    @id @default(cuid())
  eventId    String
  title      String
  startTime  DateTime?
  endTime    DateTime?
  locationId String?
  sortIndex  Int

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([eventId, sortIndex])
}

model TravelStop {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  startsAt  DateTime?
  endsAt    DateTime?
  sortIndex Int
  lat       Float?
  lng       Float?
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  steps  TravelStep[]
  places TravelPlace[]

  @@index([eventId])
  @@index([eventId, sortIndex])
}

model TravelStep {
  id        String   @id @default(cuid())
  eventId   String
  stopId    String
  title     String
  startsAt  DateTime?
  endsAt    DateTime?
  sortIndex Int
  summary   String?
  routeMode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stop       TravelStop  @relation(fields: [stopId], references: [id], onDelete: Cascade)
  stepPlaces StepPlace[]

  @@index([eventId])
  @@index([stopId, sortIndex])
}

model TravelPlace {
  id        String   @id @default(cuid())
  eventId   String
  stopId    String?
  parentId  String?
  title     String
  lat       Float?
  lng       Float?
  address   String?
  category  String?
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stop       TravelStop?   @relation(fields: [stopId], references: [id], onDelete: SetNull)
  parent     TravelPlace?  @relation("PlaceTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   TravelPlace[] @relation("PlaceTree")
  stepPlaces StepPlace[]

  @@index([eventId])
  @@index([stopId])
  @@index([parentId])
}

model StepPlace {
  id        String  @id @default(cuid())
  stepId    String
  placeId   String
  role      String?
  sortIndex Int     @default(0)
  routeStop Boolean @default(true)

  step  TravelStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  place TravelPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([placeId])
  @@unique([stepId, placeId])
}

model NotePage {
  id          String   @id @default(cuid())
  eventId     String
  ownerType   String
  ownerId     String
  title       String
  markdown    String
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([ownerType, ownerId])
}

model EventState {
  eventId        String   @id
  currentSlotId  String?
  updatedAt      DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  eventId   String
  text      String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([eventId, createdAt])
}

model ChatRoom {
  id          String   @id @default(cuid())
  eventId     String
  key         String
  title       String
  isAdminOnly Boolean  @default(false)
  createdAt   DateTime @default(now())

  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([eventId, key])
  @@index([eventId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  eventId   String
  roomId    String
  guestId   String
  guestName String
  text      String
  createdAt DateTime @default(now())

  // Editing fields
  editedAt    DateTime?
  isEdited    Boolean   @default(false)
  editHistory Json?

  // Deletion fields
  deletedAt   DateTime?
  deletedBy   String?
  isDeleted   Boolean   @default(false)

  event Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  room  ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([roomId])
  @@index([roomId, createdAt])
  @@index([roomId, isDeleted, createdAt])
}
